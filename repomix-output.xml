        totalCost: { metal: 9000, crystal: 3000, deuterium: 0 },
        totalTime: 30,
      },
      currentProgress: 0,
      startedAt: startTime,
    };

    const nextTime = getNextCompletionTime(queue);
    expect(nextTime).toBe(startTime + 10 * 1000); // 10 seconds in milliseconds
  });
});

