    deuterium: 0,
    rapidfire: {},
  },
  gaussCannon: {
    hull: 35000,
    shield: 200,
    attack: 1100,
    metal: 20000,
    crystal: 15000,
    deuterium: 2000,
    rapidfire: {},
  },
  ionCannon: {
    hull: 8000,
    shield: 500,
    attack: 150,
