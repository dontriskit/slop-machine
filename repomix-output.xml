    it('should handle zero-cargo fleet', () => {
      const survivorShips: Ships = {
        lightFighter: 0,
        heavyFighter: 0,
        cruiser: 0,
        battleship: 0,
        battlecruiser: 0,
        bomber: 0,
        destroyer: 0,
        deathstar: 0,
        smallCargo: 0,
        largeCargo: 0,
        colonyShip: 0,
        recycler: 0,
        espionageProbe: 0,
