      await expect(
        createAlliance('p1', 'Valid Name', 'TOOLONGTAG', '', db),
      ).rejects.toThrow('3–8 uppercase');
    });

    test('rejects tag with special characters', async () => {
      await expect(
        createAlliance('p1', 'Valid Name', 'AB!', '', db),
      ).rejects.toThrow('3–8 uppercase');
    });

    test('throws if player does not exist', async () => {
