    rapidfire: {},
  },
  plasmaTurret: {
    hull: 100000,
    shield: 300,
    attack: 3000,
    metal: 50000,
    crystal: 50000,
    deuterium: 30000,
    rapidfire: {},
  },
  smallShieldDome: {
