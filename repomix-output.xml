    it('returns null when moon not found', async () => {
      mockDb.first.mockResolvedValueOnce(null);

      const moon = await getMoonByPlanetId('planet_456', mockDb);
      expect(moon).toBeNull();
    });
  });

  describe('getMoonById', () => {
