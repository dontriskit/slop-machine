app.delete('/api/defense/cancel/:queueId', async (c) => {
  const queueId = c.req.param('queueId');
  const planetId = c.req.query('planetId');

  if (!planetId) {
    return c.json({ error: 'planetId query parameter is required' }, 400);
  }

  const DB = c.env.DB;
  const KV = c.env.KV;

  try {
