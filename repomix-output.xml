  // --------------------------------------------------------------------------

  describe('dissolveAlliance', () => {
    test('founder can dissolve alliance', async () => {
      const alliance = await createAlliance('p1', 'Doomed', 'DMD', '', db);
      await dissolveAlliance(alliance.id, 'p1', db);

      const row = await db
        .prepare('SELECT id FROM alliances WHERE id = ?')
        .bind(alliance.id)
