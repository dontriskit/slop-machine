function createBuildHistoryRow(
  planetId: string,
  buildingId: number,
  level: number,
  source: 'agent' | 'manual',
  createdAt: number,
  aiReason: string | null = null
): MockRow {
  return {
    id: `bh-${planetId}-${createdAt}-${Math.random().toString(36).slice(2, 8)}`,
    planet_id: planetId,
    building_id: buildingId,
    level,
    source,
    ai_reason: aiReason,
    created_at: createdAt,
  };
}

function createPlanetRow(
  id: string,
  playerId: string,
  agentEnabled: number = 1,
  strategyId: string | null = null
): MockRow {
  return {
    id,
    player_id: playerId,
    name: 'TestPlanet',
    galaxy: 1,
    system: 1,
    position: 1,
    planet_type: 'planet',
    temperature: 30,
    fields: 163,
    universe_speed: 1,
    agent_enabled: agentEnabled,
    strategy_id: strategyId,
    created_at: 1000000,
  };
}

