  shield: number;
  attack: number;
  metal: number;
  crystal: number;
  deuterium: number;
  rapidfire: Record<string, number>;
}

const DEFENSE_BATTLE_SPECS: Record<keyof DefenseStructures, DefenseSpec> = {
