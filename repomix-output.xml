        }
      }
    });

    it('should generate an alien NPC fleet', () => {
      for (let i = 0; i < 100; i++) {
        const result = resolveExpedition(100000, 0, i);
        if (result.eventType === 'alien_contact') {
          expect(result.npcFleet).toBeDefined();
          const totalShips = Object.values(result.npcFleet!).reduce(
            (sum, count) => sum + count,
