              </button>
            </div>

            <div style={{ marginTop: 24, borderTop: '1px solid #ff444433', paddingTop: 14 }}>
              <div style={{ ...styles.sectionLabel, color: '#ff4444' }}>DANGER ZONE</div>
              <p style={{ color: '#ff4444', fontSize: 12, marginBottom: 8 }}>
